# ---- App ----
PROJECT_NAME="DataNova"
ENVIRONMENT=development

# ---- Database ----
# For docker-compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+psycopg2://analytics:analytics@localhost:5432/analytics

# Used by docker-compose to provision the Postgres container:
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=analytics

# ---- Auth / JWT ----
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS (comma-separated origins) ----
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- LLM (OpenRouter, OpenAI-compatible) ----
# Leave OPENROUTER_API_KEY blank to use the rule-based fallback for explanations.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_MAX_TOKENS=500
LLM_TIMEOUT=30
